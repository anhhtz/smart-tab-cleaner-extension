{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "tabs",
    "history"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extActionTitle__"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
