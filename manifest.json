{
  "manifest_version": 3,
  "name": "Smart Tab Cleaner",
  "version": "2.1.0",
  "description": "Tự động đóng tab thông minh theo quy tắc hoặc block nhanh từ lịch sử duyệt web với Cloud Sync.",
  "permissions": [
    "storage",
    "tabs",
    "history"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Tab Cleaner"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
